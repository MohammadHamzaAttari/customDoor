    accentColor: string,
  ) => {
    const label = side === "left" ? "Left Angle" : "Right Angle";
    const icon = side === "left" ? "◢" : "◣";

    return (
      <div
        className={cn(
          "rounded-xl border-2 transition-all duration-300",
          enabled
            ? `border-${accentColor}-200 bg-${accentColor}-50/50`
            : "border-gray-100 bg-gray-50/50",
        )}
