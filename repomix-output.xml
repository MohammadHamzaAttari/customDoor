      min-height: 500px;
    }
    #door-designer-iframe {
      min-height: 500px;
    }
    .door-designer-heading-container {
      padding: 0 10px;
    }
  }
</style>

<div class="door-designer-section-full-width {% if block.settings.full_width_breakout %}breakout{% endif %}">
  
  {% if block.settings.heading != blank %}
    <div class="door-designer-heading-container">
      <h2 class="door-designer-heading" style="text-align: {{ block.settings.heading_align }}; margin-bottom: 20px; padding-top: 20px;">
        {{ block.settings.heading }}
      </h2>
    </div>
  {% endif %}

  <div id="door-designer-container" class="door-designer-iframe-container">
    <iframe 
      id="door-designer-iframe"
      src="{{ block.settings.app_url }}" 
      allow="fullscreen"
      scrolling="no"
    ></iframe>
  </div>
</div>

<script>
(function() {
  const iframe = document.getElementById('door-designer-iframe');
  const container = document.getElementById('door-designer-container');
  
  if (!iframe || !container) return;

  // Listen for messages from the door designer app
  window.addEventListener('message', function(event) {
    // Validate origin if needed
    // if (event.origin !== '{{ block.settings.app_url }}') return;
    
    const data = event.data;
    
    if (typeof data === 'object') {
      // Handle height adjustment
      if (data.type === 'resize' && data.height) {
        const newHeight = Math.max(data.height, {{ block.settings.container_height }});
        iframe.style.minHeight = newHeight + 'px';
        container.style.minHeight = newHeight + 'px';
        console.log('Door Designer resized to:', newHeight);
      }
      
      // Handle modal open/close
      if (data.type === 'modalOpen') {
        container.classList.add('modal-open');
        document.body.style.overflow = 'hidden';
        console.log('Door Designer modal opened');
      }
      
      if (data.type === 'modalClose') {
        container.classList.remove('modal-open');
        document.body.style.overflow = '';
        console.log('Door Designer modal closed');
      }
      
      // Handle scroll to top (when order is submitted, etc.)
      if (data.type === 'scrollToTop') {
        window.scrollTo({ top: container.offsetTop - 20, behavior: 'smooth' });
      }
      
      // Log other messages
      console.log('Message from Door Designer:', data);
    }
  });

  // Send parent info to iframe when it loads
  iframe.addEventListener('load', function() {
    // Notify the iframe about parent container dimensions
    iframe.contentWindow.postMessage({
      type: 'parentInfo',
      width: container.offsetWidth,
      height: container.offsetHeight,
      isEmbedded: true
    }, '*');
  });

  // Handle window resize
  let resizeTimeout;
  window.addEventListener('resize', function() {
    clearTimeout(resizeTimeout);
    resizeTimeout = setTimeout(function() {
      if (iframe.contentWindow) {
        iframe.contentWindow.postMessage({
          type: 'parentResize',
          width: container.offsetWidth,
          height: container.offsetHeight
        }, '*');
      }
    }, 100);
  });

  // Handle escape key to close modal
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && container.classList.contains('modal-open')) {
      container.classList.remove('modal-open');
      document.body.style.overflow = '';
      // Notify iframe that modal was closed from parent
      if (iframe.contentWindow) {
        iframe.contentWindow.postMessage({ type: 'parentModalClose' }, '*');
      }
    }
  });
})();
</script>

